const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://buildhire.com.au/#website",
  "name": "BuildHire",
  "url": "https://buildhire.com.au",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://buildhire.com.au/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
