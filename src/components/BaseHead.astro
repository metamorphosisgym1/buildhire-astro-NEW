---
export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage = '/og-image.png',
  noindex = false,
  crumbs,
} = Astro.props;

const rawCanonicalPath = canonicalPath ?? Astro.url.pathname;
const normalisedCanonicalPath = rawCanonicalPath === '/'
  ? '/'
  : rawCanonicalPath.endsWith('/')
    ? rawCanonicalPath
    : `${rawCanonicalPath}/`;
const canonicalUrl = new URL(normalisedCanonicalPath, Astro.site || 'https://buildhire.com.au');
const breadcrumbSchema = crumbs && crumbs.length ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au/" },
    ...crumbs.map((c, i) => ({ "@type": "ListItem", "position": i + 2, "name": c.name, "item": `https://buildhire.com.au${c.path}` })),
  ],
} : null;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "BuildHire",
  "url": "https://buildhire.com.au",
  "logo": "https://buildhire.com.au/favicon.png",
  "description": "Sydney excavator and construction equipment hire company. Mini excavator dry hire from $200/day, with availability and delivery quoted for the site and hire dates.",
  "telephone": "+611300157882",
  "email": "info@buildhire.com.au",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "178 Princes Hwy",
    "addressLocality": "Arncliffe",
    "addressRegion": "NSW",
    "postalCode": "2205",
    "addressCountry": "AU"
  },
  "areaServed": {
    "@type": "State",
    "name": "New South Wales",
    "containsPlace": [
      { "@type": "City", "name": "Sydney" },
      { "@type": "City", "name": "Wollongong" }
    ]
  },
  "@id": "https://buildhire.com.au/#organization",
  "sameAs": [
    "https://www.facebook.com/people/Build-Hire/61586999393373/",
    "https://www.instagram.com/buildhiresydney/",
    "https://www.linkedin.com/company/buildhire",
    "https://buildhire.com.au"
  ],
  "knowsAbout": [
    "Excavator Hire",
    "Mini Excavator Dry Hire",
    "Construction Equipment Hire",
    "Earthmoving Equipment Sydney",
    "Dry Hire vs Wet Hire",
    "Plant Hire NSW",
    "Excavator Delivery Sydney"
  ],
  "priceRange": "$$",
  "foundingDate": "2024",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "05:00",
      "closes": "20:00"
    }
  ],
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "BuildHire",
  "image": "https://buildhire.com.au/og-image.png",
  "url": "https://buildhire.com.au",
  "telephone": "+611300157882",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "178 Princes Hwy",
    "addressLocality": "Arncliffe",
    "addressRegion": "NSW",
    "postalCode": "2205",
    "addressCountry": "AU"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -33.9408948,
    "longitude": 151.1462229
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "05:00",
      "closes": "20:00"
    }
  ],
  "priceRange": "$$",
  "description": "Sydney excavator and construction equipment hire. Mini excavator dry hire from $200/day, with availability and delivery quoted for the site and hire dates.",
  "hasMap": "https://maps.google.com/maps?cid=9165786726029020518",
  "areaServed": {
    "@type": "State",
    "name": "New South Wales",
    "containsPlace": [
      { "@type": "City", "name": "Sydney" },
      { "@type": "City", "name": "Wollongong" },
      { "@type": "City", "name": "Parramatta" },
      { "@type": "City", "name": "Penrith" }
    ]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://buildhire.com.au/#website",
  "name": "BuildHire",
  "url": "https://buildhire.com.au",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://buildhire.com.au/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  "url": canonicalUrl.toString(),
  "name": title,
  "description": description,
  "inLanguage": "en-AU",
  "isPartOf": { "@id": "https://buildhire.com.au/#website" },
  "about": { "@id": "https://buildhire.com.au/#organization" },
  "dateModified": "2026-07-22",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", ".answer-short", ".answer-full", "[data-speakable]"]
  }
};
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Performance: Preload critical assets -->
<link rel="dns-prefetch" href="https://wa.me" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="author" content="BuildHire" />
<meta name="facebook-domain-verification" content="y28qhqf4wdzl0lifml9oidndihnp3q" />
<meta name="theme-color" content="#f5a623" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="shortcut icon" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.site || 'https://buildhire.com.au' )} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.site || 'https://buildhire.com.au' )} />

<!-- Schema.org Markup -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-8W2E1TCKN2"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', 'G-8W2E1TCKN2');
</script>

<!-- Microsoft Clarity (project ysnroup82i): recordings and heatmaps, inputs masked. Added 5 Oct 2026, owner approved; disclosed on /privacy/. -->
<script is:inline>
  (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "ysnroup82i");
</script>

<!-- Contact attribution: records only click context, never phone numbers or message contents. -->
<script>
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('a') : null;
    if (!link) return;

    const href = link.getAttribute('href') || '';
    if (href.startsWith('tel:')) {
      window.gtag?.('event', 'click_to_call', {
        contact_channel: 'phone',
        page_path: window.location.pathname,
      });
    }

    if (href.includes('wa.me')) {
      window.gtag?.('event', 'whatsapp_contact_click', {
        contact_channel: 'whatsapp',
        page_path: window.location.pathname,
      });
    }

    if (href.includes('#booking')) {
      window.gtag?.('event', 'equipment_planner_quote_start', {
        contact_channel: 'booking_form',
        page_path: window.location.pathname,
      });
    }
  });
</script>
