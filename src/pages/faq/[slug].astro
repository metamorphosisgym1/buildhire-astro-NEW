---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
import { faqs } from '../../data/faqs';
import { equipment } from '../../data/equipment';

export async function getStaticPaths() {
  return faqs.map(faq => ({
    params: { slug: faq.slug },
    props: { faq }
  }));
}

const { faq } = Astro.props;
const title = `${faq.question} | BuildHire FAQ`;
const description = faq.answer.substring(0, 155) + '...';
const canonicalPath = `/faq/${faq.slug}/`;

// Related equipment items
const relatedItems = faq.relatedEquipment
  ? equipment.filter(e => faq.relatedEquipment!.includes(e.slug))
  : [];

// Related FAQs in same category
const relatedFaqs = faqs
  .filter(f => f.category === faq.category && f.slug !== faq.slug)
  .slice(0, 4);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://www.buildhire.com.au/faq" },
    { "@type": "ListItem", "position": 3, "name": faq.question, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": faq.question,
  "description": description,
  "url": `https://www.buildhire.com.au${canonicalPath}`,
  "publisher": {
    "@type": "Organization",
    "name": "BuildHire",
    "url": "https://www.buildhire.com.au",
    "logo": { "@type": "ImageObject", "url": "https://www.buildhire.com.au/images/buildhire-logo.png" }
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".answer-text"]
  }
};
---
<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="min-h-screen bg-[var(--color-bg)]">
    <Header client:load />

    <!-- Breadcrumb -->
    <div class="bg-white border-b border-gray-100 py-3">
      <div class="max-w-4xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)]">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">›</span>
          <a href="/faq" class="hover:text-[var(--color-primary)]">FAQ</a>
          <span class="mx-2">›</span>
          <span class="text-[var(--color-text)]">{faq.category}</span>
        </nav>
      </div>
    </div>

    <!-- Hero Answer -->
    <section class="bg-[var(--color-text)] py-16">
      <div class="max-w-4xl mx-auto px-6">
        <div class="inline-block bg-[var(--color-primary)] text-white text-xs font-bold px-3 py-1 rounded-full mb-6 uppercase tracking-wider">
          {faq.category}
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-8 leading-tight">
          {faq.question}
        </h1>
        <div class="bg-white/10 rounded-2xl p-8">
          <p class="answer-text text-white/90 text-lg leading-relaxed">
            {faq.answer}
          </p>
        </div>
      </div>
    </section>

    <!-- Related Equipment -->
    {relatedItems.length > 0 && (
      <section class="bg-white py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
            Relevant Equipment for Hire
          </h2>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
            {relatedItems.map(item => (
              <a href={`/hire/${item.slug}/sydney/`} class="bg-[var(--color-bg)] rounded-xl p-6 hover:shadow-md transition group">
                <div class="text-sm text-[var(--color-text-muted)] mb-1">{item.category}</div>
                <h3 class="font-bold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-primary)] transition">{item.shortName}</h3>
                <div class="text-[var(--color-primary)] font-semibold text-sm mb-3">{item.price}</div>
                <span class="text-xs text-[var(--color-primary)] font-semibold">View Hire Details →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-2xl font-bold text-white mb-4">Ready to Hire Equipment?</h2>
        <p class="text-white/80 mb-8">Next-day delivery across Sydney and NSW. Transparent pricing, no hidden fees.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <!-- Related FAQs -->
    {relatedFaqs.length > 0 && (
      <section class="bg-[var(--color-bg)] py-16">
        <div class="max-w-4xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
            More Questions About {faq.category}
          </h2>
          <div class="space-y-4">
            {relatedFaqs.map(related => (
              <a href={`/faq/${related.slug}/`} class="block bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition group">
                <div class="flex justify-between items-center">
                  <h3 class="font-semibold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition pr-4">
                    {related.question}
                  </h3>
                  <span class="text-[var(--color-primary)] text-xl flex-shrink-0">→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
