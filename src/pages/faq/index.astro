---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
import { faqs } from '../../data/faqs';

const title = "Equipment Hire FAQ | BuildHire — Sydney & NSW";
const description = "Answers to the most common questions about excavator hire, mini dumper hire, tipper truck hire, licensing, delivery, and pricing in Sydney and NSW.";
const canonicalPath = "/faq/";

// Group FAQs by category
const categories = [...new Set(faqs.map(f => f.category))];
const grouped = categories.map(cat => ({
  category: cat,
  faqs: faqs.filter(f => f.category === cat)
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.slice(0, 20).map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};
---
<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-[var(--color-bg)]">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[var(--color-text)] py-16">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <div class="inline-block bg-[var(--color-primary)] text-white text-xs font-bold px-3 py-1 rounded-full mb-6 uppercase tracking-wider">
          Help Centre
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-white/70 text-lg max-w-2xl mx-auto">
          Everything you need to know about hiring excavators, tipper trucks, and mini dumpers in Sydney and NSW.
        </p>
      </div>
    </section>

    <!-- FAQ Categories -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-6">
        {grouped.map(group => (
          <div class="mb-12">
            <h2 class="text-xl font-bold text-[var(--color-text)] mb-6 pb-3 border-b border-gray-200">
              {group.category}
            </h2>
            <div class="space-y-3">
              {group.faqs.map(faq => (
                <a href={`/faq/${faq.slug}/`} class="flex justify-between items-center bg-white rounded-xl px-6 py-5 shadow-sm hover:shadow-md transition group">
                  <span class="font-medium text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition pr-4">
                    {faq.question}
                  </span>
                  <span class="text-[var(--color-primary)] text-xl flex-shrink-0">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-2xl font-bold text-white mb-4">Still Have Questions?</h2>
        <p class="text-white/80 mb-8">Our team is available 7 days a week to help you choose the right equipment for your project.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition">
            Get a Quote →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
