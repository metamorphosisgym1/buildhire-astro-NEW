---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header';
import Footer from '../../../../components/Footer';
import ChatWidget from '../../../../components/ChatWidget';
import StickyBottomBar from '../../../../components/StickyBottomBar';
import { competitors } from '../../../../data/competitors';
import { industries } from '../../../../data/industries';
import { locations } from '../../../../data/locations';
import { equipment } from '../../../../data/equipment';

export async function getStaticPaths() {
  return competitors.flatMap(competitor =>
    industries.flatMap(industry =>
      locations.map(location => ({
        params: {
          competitorSlug: competitor.slug,
          industrySlug: industry.slug,
          locationSlug: location.slug
        },
        props: { competitor, industry, location }
      }))
    )
  );
}

const { competitor, industry, location } = Astro.props;

const title = `BuildHire vs ${competitor.category} for ${industry.name} in ${location.name} — Equipment Hire Comparison`;
const description = `Comparing BuildHire with ${competitor.categoryPlural} for ${industry.name.toLowerCase()} equipment hire in ${location.name}. ${competitor.buildhireAdvantage}`;
const canonicalPath = `/compare/${competitor.slug}/${industry.slug}/${location.slug}/`;

const recommendedEquipment = equipment.filter(e =>
  industry.equipmentRecommendations.includes(e.slug)
).slice(0, 3);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://www.buildhire.com.au/compare/" },
    { "@type": "ListItem", "position": 3, "name": `${competitor.category} vs BuildHire`, "item": `https://www.buildhire.com.au/compare/${competitor.slug}/` },
    { "@type": "ListItem", "position": 4, "name": `${industry.name} — ${location.name}`, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};

const allFaqs = [
  ...competitor.faqs,
  ...industry.faqs.slice(0, 2),
  {
    q: `Does BuildHire deliver ${industry.name.toLowerCase()} equipment to ${location.name}?`,
    a: `Yes. BuildHire delivers to ${location.name} and the wider ${location.region} region. Book before 12pm for next-day delivery to ${location.name} ${industry.name.toLowerCase()} sites.`
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".speakable-summary", ".speakable-answer"]
  }
};
---
<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)] mb-6 flex items-center gap-2 flex-wrap">
          <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
          <span>/</span>
          <a href="/compare/" class="hover:text-[var(--color-primary)] transition-colors">Compare</a>
          <span>/</span>
          <span class="text-[var(--color-text)]">{competitor.category} vs BuildHire — {industry.name} — {location.name}</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6">
          📍 {location.name}, {location.region}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
          BuildHire vs {competitor.categoryPlural}<br />
          <span class="text-[var(--color-primary)]">{industry.name} Equipment Hire in {location.name}</span>
        </h1>

        <p class="text-xl text-[var(--color-text-muted)] mb-8 max-w-3xl leading-relaxed speakable-summary">
          {competitor.theirApproach} Here's how BuildHire compares for {industry.name.toLowerCase()} contractors in {location.name}.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="https://www.buildhire.com.au/#booking" class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-primary)] text-white font-semibold rounded-lg hover:opacity-90 transition-opacity">
            Book with BuildHire — 2 Minutes
          </a>
          <a href="tel:1300157882" class="inline-flex items-center gap-2 px-6 py-3 border border-[var(--color-border)] text-[var(--color-text)] font-semibold rounded-lg hover:border-[var(--color-primary)] transition-colors">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="bg-[var(--color-surface)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
          BuildHire vs {competitor.categoryPlural} — Side by Side
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-border)]">
                <th class="text-left py-3 px-4 text-[var(--color-text-muted)] font-medium text-sm">Feature</th>
                <th class="text-left py-3 px-4 text-[var(--color-text-muted)] font-medium text-sm">{competitor.categoryPlural}</th>
                <th class="text-left py-3 px-4 text-[var(--color-primary)] font-semibold text-sm">BuildHire ✓</th>
              </tr>
            </thead>
            <tbody>
              {competitor.keyDifferences.map((diff, i) => (
                <tr class={`border-b border-[var(--color-border)] ${i % 2 === 0 ? 'bg-[var(--color-bg)]' : ''}`}>
                  <td class="py-3 px-4 text-sm font-medium text-[var(--color-text)]">{diff.label}</td>
                  <td class="py-3 px-4 text-sm text-[var(--color-text-muted)]">{diff.them}</td>
                  <td class="py-3 px-4 text-sm text-[var(--color-primary)] font-medium">{diff.us}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- BuildHire Advantage -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-start">
          <div>
            <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">
              Why {industry.name} Contractors in {location.name} Choose BuildHire
            </h2>
            <p class="text-[var(--color-text-muted)] leading-relaxed mb-6 speakable-answer">
              {competitor.buildhireAdvantage}
            </p>
            <p class="text-[var(--color-text-muted)] leading-relaxed">
              {industry.longDescription}
            </p>
          </div>
          <div class="space-y-4">
            <div class="p-5 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
              <h3 class="font-bold text-[var(--color-text)] mb-3">BuildHire at a Glance</h3>
              <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> All-inclusive pricing from $200/day published online</li>
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> Next-day delivery to {location.name}</li>
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> Late-model fleet, serviced before every hire</li>
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> Online booking in 2 minutes, 24/7</li>
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> 1-day minimum hire</li>
                <li class="flex items-start gap-2"><span class="text-[var(--color-primary)]">→</span> Same-day breakdown response</li>
              </ul>
            </div>
            <div class="p-5 bg-[var(--color-primary)]/5 rounded-xl border border-[var(--color-primary)]/20">
              <p class="text-sm font-medium text-[var(--color-text)] mb-1">Ready to compare in person?</p>
              <p class="text-sm text-[var(--color-text-muted)] mb-3">Book online and see the difference.</p>
              <a href="tel:1300157882" class="text-[var(--color-primary)] font-bold text-lg hover:underline">1300 157 882</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Recommended Equipment for Industry -->
    {recommendedEquipment.length > 0 && (
      <section class="bg-[var(--color-surface)] py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
            Equipment for {industry.name} in {location.name}
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {recommendedEquipment.map(item => (
              <a href={`/hire/${item.slug}/${location.slug}/`} class="block p-5 bg-[var(--color-bg)] rounded-xl border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors group">
                <h3 class="font-bold text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition-colors mb-2">{item.shortName}</h3>
                <p class="text-[var(--color-primary)] font-semibold text-sm mb-2">{item.price}</p>
                <p class="text-xs text-[var(--color-text-muted)]">{item.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
          Frequently Asked Questions — {industry.name} Equipment Hire in {location.name}
        </h2>
        <div class="space-y-4">
          {allFaqs.map(faq => (
            <div class="p-6 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
              <h3 class="font-semibold text-[var(--color-text)] mb-2">{faq.q}</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed speakable-answer">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Footer />
  </div>
  <ChatWidget client:load />
  <StickyBottomBar client:load />
</Layout>
