---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
import { competitors } from '../../data/competitors';

export async function getStaticPaths() {
  return competitors.map(competitor => ({
    params: { competitorSlug: competitor.slug },
    props: { competitor }
  }));
}

const { competitor } = Astro.props;

// Generic terms used throughout — competitor name is NOT mentioned for legal safety
const genericTerm = competitor.categoryPlural;

const title = `BuildHire vs ${genericTerm} | Equipment Hire Comparison`;
const description = `Comparing BuildHire against ${genericTerm.toLowerCase()} for excavator and earthmoving hire in Sydney and NSW? See why contractors choose BuildHire for transparent pricing, next-day delivery, and late-model equipment.`;
const canonicalPath = `/compare/${competitor.slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Compare", "item": "https://www.buildhire.com.au/compare" },
    { "@type": "ListItem", "position": 3, "name": `vs ${genericTerm}`, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How does BuildHire compare to ${genericTerm.toLowerCase()} on price?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `BuildHire publishes transparent, all-inclusive rates online starting from $200/day for mini excavators. ${genericTerm} often require you to call for a quote and may add environmental levies, damage waivers, and fuel surcharges on top of the headline rate.`
      }
    },
    {
      "@type": "Question",
      "name": "Does BuildHire offer next-day delivery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. BuildHire guarantees next-day delivery for bookings placed before 12pm across Greater Sydney and NSW. Call 1300 157 882 to confirm availability for your location."
      }
    },
    {
      "@type": "Question",
      "name": "What equipment does BuildHire offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "BuildHire specialises in dry hire of excavators (0.8T to 5.5T), tipper trucks, and mini dumpers. All machines are late-model Yanmar and Kubota equipment, regularly serviced to the highest standards."
      }
    }
  ]
};

const comparisonRows = [
  { label: "Pricing", us: "Transparent online rates — no surprises", them: "Often requires calling; add-on fees common" },
  { label: "Next-Day Delivery", us: "Guaranteed (book by 12pm)", them: "Varies by branch and availability" },
  { label: "Equipment Age", us: "Late-model Yanmar & Kubota fleet", them: "Mixed fleet age — older machines common" },
  { label: "Hidden Fees", us: "Zero hidden fees, all-inclusive", them: "Environmental levies, damage waivers, fuel surcharges" },
  { label: "Support", us: "Direct line to manager — 24/7", them: "Call centre routing; variable response times" },
  { label: "Booking Process", us: "Online in 60 seconds", them: "Phone or in-branch only" }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="min-h-screen pb-20">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <!-- Breadcrumb -->
        <nav class="text-sm text-[var(--color-text-muted)] mb-8 flex items-center justify-center gap-2">
          <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
          <span>/</span>
          <span class="text-[var(--color-text)]">Compare</span>
        </nav>

        <h1 class="text-4xl md:text-6xl font-bold text-[var(--color-text)] mb-6">
          BuildHire vs <span class="text-[var(--color-text-muted)]">{genericTerm}</span>
        </h1>
        <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
          See why Sydney and NSW contractors are switching to BuildHire for their dry hire needs instead of {genericTerm.toLowerCase()}.
        </p>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="bg-white py-16">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <!-- Header -->
          <div class="grid grid-cols-3 bg-gray-50 border-b border-gray-200 p-4 md:p-6 font-bold text-center">
            <div class="text-left text-[var(--color-text)]">Feature</div>
            <div class="text-[var(--color-primary)] text-xl">BuildHire</div>
            <div class="text-[var(--color-text-muted)]">{genericTerm}</div>
          </div>

          <!-- Rows -->
          <div class="divide-y divide-gray-100">
            {comparisonRows.map(row => (
              <div class="grid grid-cols-3 p-4 md:p-6 text-center items-start">
                <div class="text-left font-medium text-[var(--color-text)] text-sm">{row.label}</div>
                <div class="flex flex-col items-center gap-2">
                  <span class="text-green-500 text-lg">✓</span>
                  <span class="text-sm text-[var(--color-text)]">{row.us}</span>
                </div>
                <div class="flex flex-col items-center gap-2 text-[var(--color-text-muted)]">
                  <span class="text-sm">{row.them}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((faq: any) => (
            <details class="bg-white rounded-xl p-6 shadow-sm group">
              <summary class="font-semibold text-[var(--color-text)] cursor-pointer list-none flex justify-between items-center">
                {faq.name}
                <span class="text-[var(--color-primary)] ml-4 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-4 text-[var(--color-text-muted)] text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Experience the BuildHire Difference?</h2>
        <p class="text-white/80 mb-8 text-lg">
          Book online in 60 seconds or call us for an instant quote. Next-day delivery across Sydney & NSW.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
