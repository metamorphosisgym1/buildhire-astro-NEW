---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import ChatWidget from '../components/ChatWidget';
import StickyBottomBar from '../components/StickyBottomBar';
---
<Layout
  title="Privacy Policy | BuildHire"
  description="BuildHire privacy policy — how we collect, use and protect your personal information."
  canonicalPath="/privacy/"
>
  <div class="min-h-screen pb-20">
    <Header client:load />
    <main>
      <section class="bg-[var(--color-bg)] pt-32 pb-16">
        <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl font-bold text-[var(--color-text)] mb-6">Privacy Policy</h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-4">BuildHire is committed to protecting your privacy in accordance with the Australian Privacy Act 1988.</p>
        </div>
      </section>
    </main>
    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
