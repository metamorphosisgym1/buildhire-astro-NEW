---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';

// Rates and machine matches come from the booking calculator (src/components/BookingCalculator.tsx),
// last changed by BuildHire on 24 and 28 June 2026. Change them there and here together.
const attachments = [
  {
    id: "hydraulic-hammer",
    name: "Hydraulic Hammer (Rock Breaker)",
    image: null,
    what: "Breaks concrete slabs, footings, sandstone and hard ground that the bucket cannot dig.",
    rates: [
      { machine: "0.8T and 1T", href: "/equipment/08t-mini-excavator-hire-sydney/", rate: 130 },
      { machine: "1.7T", href: "/equipment/17t-mini-excavator-hire-sydney/", rate: 130 },
      { machine: "3.5T", href: "/equipment/35t-excavator-hire-sydney/", rate: 140 },
      { machine: "5.5T", href: "/equipment/55t-excavator-hire-sydney/", rate: 190 },
      { machine: "14.5T", href: "/equipment/145t-excavator-hire-sydney/", rate: 250 },
    ],
  },
  {
    id: "auger-drive",
    name: "Auger Drive",
    image: { src: "/assets/auger-drive.jpg", alt: "Hydraulic auger drive attachment for excavator hire in Sydney", w: 300, h: 300 },
    what: "Drills holes for fence posts, pier footings, retaining wall posts and stumps. 200 mm, 300 mm and 450 mm drill sizes on the 1.7T and bigger machines.",
    rates: [
      { machine: "0.8T and 1T (one drill size)", href: "/equipment/1t-mini-excavator-hire-sydney/", rate: 130 },
      { machine: "1.7T", href: "/equipment/17t-mini-excavator-hire-sydney/", rate: 130 },
      { machine: "3.5T", href: "/equipment/35t-excavator-hire-sydney/", rate: 160 },
      { machine: "5.5T", href: "/equipment/55t-excavator-hire-sydney/", rate: 180 },
      { machine: "14.5T", href: "/equipment/145t-excavator-hire-sydney/", rate: 230 },
    ],
  },
  {
    id: "rock-grab",
    name: "Hydraulic Rock Grab",
    image: { src: "/assets/rock-grab.webp", alt: "Tiger hydraulic rock grab attachment for excavator hire in Sydney", w: 1600, h: 1535 },
    what: "Picks up and places rocks, logs and rubble. Handy for retaining walls, rock placement and site clean up.",
    rates: [
      { machine: "3.5T", href: "/equipment/35t-excavator-hire-sydney/", rate: 135 },
      { machine: "5.5T", href: "/equipment/55t-excavator-hire-sydney/", rate: 150 },
      { machine: "14.5T", href: "/equipment/145t-excavator-hire-sydney/", rate: 180 },
    ],
  },
  {
    id: "sieve-bucket",
    name: "Sieve Bucket (Tiger Buckets)",
    image: { src: "/assets/sieve-bucket-tiger.png", alt: "Tiger sieve bucket attachment for excavator hire in Sydney", w: 570, h: 471 },
    what: "Sifts rock, roots and rubble out of soil so you can reuse the soil on site.",
    rates: [
      { machine: "1.7T", href: "/equipment/17t-mini-excavator-hire-sydney/", rate: 50 },
      { machine: "3.5T", href: "/equipment/35t-excavator-hire-sydney/", rate: 50 },
      { machine: "5.5T", href: "/equipment/55t-excavator-hire-sydney/", rate: 50 },
      { machine: "14.5T", href: "/equipment/145t-excavator-hire-sydney/", rate: 50 },
    ],
  },
];

const faqs = [
  { q: "Can I hire an excavator with a rock breaker?", a: "Yes. We have a hydraulic hammer to suit every machine we hire, from the 0.8T up to the 14.5T. It costs $130 a day on the 0.8T, 1T and 1.7T, $140 on the 3.5T, $190 on the 5.5T and $250 on the 14.5T, on top of the machine rate. Ask for it when you book." },
  { q: "What attachments can I hire with an excavator?", a: "Hydraulic hammers, auger drives, hydraulic rock grabs and Tiger sieve buckets. Every excavator comes with a standard digging bucket. Which attachments fit depends on the machine size, so check the table above." },
  { q: "Which size rock breaker do I need?", a: "The hammer is matched to the machine, so pick the excavator that suits the job and we send the hammer that fits it. Tell us what you are breaking and the access to the site and we will help you choose." },
  { q: "What auger sizes do you have?", a: "The auger drives for the 1.7T, 3.5T, 5.5T and 14.5T come with 200 mm, 300 mm and 450 mm drill sizes. The 0.8T and 1T take one auger attachment." },
  { q: "How much does attachment hire cost?", a: "From $50 a day for a sieve bucket up to $250 a day for the 14.5T hammer, incl GST. Attachment rates are on top of the machine rate. Delivery and collection are quoted for your site." },
  { q: "Do you supply an operator?", a: "No. We only dry hire. You or your crew run the machine and the attachment." },
];

const lowest = Math.min(...attachments.flatMap(a => a.rates.map(r => r.rate)));
const highest = Math.max(...attachments.flatMap(a => a.rates.map(r => r.rate)));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Excavator Attachment Hire Sydney",
  "serviceType": "Excavator attachment dry hire",
  "provider": {
    "@type": "LocalBusiness",
    "name": "BuildHire",
    "url": "https://buildhire.com.au",
    "telephone": "+611300157882",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "178 Princes Hwy",
      "addressLocality": "Arncliffe",
      "addressRegion": "NSW",
      "postalCode": "2205",
      "addressCountry": "AU"
    }
  },
  "areaServed": { "@type": "City", "name": "Sydney" },
  "description": "Hydraulic hammers, auger drives, rock grabs and sieve buckets for hire with our excavators in Sydney. Matched to each machine from 0.8T to 14.5T. Delivery quoted for your site.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Excavator attachments",
    "itemListElement": attachments.map(a => ({
      "@type": "AggregateOffer",
      "name": a.name,
      "priceCurrency": "AUD",
      "lowPrice": String(Math.min(...a.rates.map(r => r.rate))),
      "highPrice": String(Math.max(...a.rates.map(r => r.rate))),
      "offerCount": a.rates.length
    }))
  }
};

---
<Layout
  crumbs={[{ name: "Equipment", path: "/equipment/" }, { name: "Excavator Attachment Hire", path: "/equipment/excavator-attachment-hire-sydney/" }]}
  title="Excavator Attachment Hire Sydney | Augers, Hammers, Rock Grabs | BuildHire"
  description="Hire a rock breaker, auger, rock grab or sieve bucket with your excavator in Sydney. Matched to each machine from 0.8T to 14.5T. Daily rates shown, delivery quoted."
  canonicalPath="/equipment/excavator-attachment-hire-sydney"
  ogImage="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="min-h-screen pb-20">
    <Header client:load />

    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-10">
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">Excavator Attachment Hire Sydney</h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
            Excavator attachment hire across Sydney from our Arncliffe yard. Add a hydraulic hammer, auger drive, rock grab or sieve bucket to your excavator hire. Each one is matched to the machine, from <strong class="text-[var(--color-primary)]">${lowest} to ${highest} a day</strong> incl GST on top of the machine rate.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Book a Machine and Attachment</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
            <a href="https://wa.me/61435421324" target="_blank" rel="noopener" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">WhatsApp Us</a>
          </div>
        </div>
        <ul class="max-w-3xl mx-auto grid sm:grid-cols-2 gap-3 text-[var(--color-text-muted)]">
          <li class="bg-white rounded-lg px-4 py-3 shadow-sm">Hydraulic hammer for every machine, 0.8T to 14.5T</li>
          <li class="bg-white rounded-lg px-4 py-3 shadow-sm">Augers with 200, 300 and 450 mm drill sizes</li>
          <li class="bg-white rounded-lg px-4 py-3 shadow-sm">Rock grabs for the 3.5T, 5.5T and 14.5T</li>
          <li class="bg-white rounded-lg px-4 py-3 shadow-sm">Standard digging bucket comes with every excavator</li>
        </ul>
      </div>
    </section>

    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4 text-center">Attachments, Rates and Which Machine They Fit</h2>
        <p class="text-center text-[var(--color-text-muted)] mb-10 max-w-2xl mx-auto">Daily rates incl GST, on top of the machine rate. Delivery and collection are quoted for your site.</p>
        <div class="grid md:grid-cols-2 gap-8">
          {attachments.map(a => (
            <div id={a.id} class="bg-[var(--color-bg)] rounded-2xl p-6 md:p-8">
              <div class="flex items-start gap-4 mb-4">
                {a.image && (
                  <img src={a.image.src} alt={a.image.alt} width={a.image.w} height={a.image.h} loading="lazy" class="w-20 h-20 object-contain bg-white rounded-lg flex-shrink-0" />
                )}
                <div>
                  <h3 class="text-xl font-bold text-[var(--color-text)]">{a.name}</h3>
                  <p class="text-sm text-[var(--color-text-muted)] mt-1">{a.what}</p>
                </div>
              </div>
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-gray-300">
                    <th class="py-2 text-left font-semibold text-[var(--color-text)]">Fits</th>
                    <th class="py-2 text-right font-semibold text-[var(--color-text)]">Per day</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  {a.rates.map(r => (
                    <tr>
                      <td class="py-2"><a href={r.href} class="underline text-[var(--color-text-muted)]">{r.machine}</a></td>
                      <td class="py-2 text-right font-semibold text-[var(--color-text)]">${r.rate}/day</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-6 text-center">Prices include GST. Fuel is not included. The 8T and 23T are coming soon; ask us about attachments for them.</p>
      </div>
    </section>

    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-6 text-center">Rock Breaker Hire</h2>
        <p class="text-[var(--color-text-muted)] mb-4">When the bucket bounces off rock or an old slab, you need a hammer. We fit a hydraulic hammer sized to the excavator, so a small breaker goes on the mini excavators for tight backyard jobs and a heavier one goes on the 5.5T and 14.5T for bigger rock and concrete.</p>
        <p class="text-[var(--color-text-muted)]">Broken rock and concrete are heavy. Most people hire a <a href="/equipment/tipper-truck-hire-sydney/" class="underline">tipper truck</a> or a <a href="/equipment/mini-dumper-hire-sydney/" class="underline">mini dumper</a> with the excavator to move it off site.</p>

        <h2 class="text-3xl font-bold text-[var(--color-text)] mt-12 mb-6 text-center">Auger Hire for Post Holes and Piers</h2>
        <p class="text-[var(--color-text-muted)]">An auger drive on an excavator drills straight, even holes much faster than a hand held post hole digger. Use it for fence posts, pier footings, retaining wall posts and stump holes. Pick the drill size for the job: 200 mm, 300 mm or 450 mm on the 1.7T and bigger machines.</p>

        <h2 class="text-3xl font-bold text-[var(--color-text)] mt-12 mb-6 text-center">Which Machine Do I Need?</h2>
        <p class="text-[var(--color-text-muted)]">Start with the access and the size of the job, then add the attachment. The <a href="/equipment/17t-mini-excavator-hire-sydney/" class="underline">1.7T mini excavator</a> suits most backyard jobs and takes a hammer, auger and sieve bucket. The <a href="/equipment/35t-excavator-hire-sydney/" class="underline">3.5T excavator</a> adds the rock grab and more power for bigger rock. See all our <a href="/equipment/mini-excavator-hire-sydney/" class="underline">mini excavator hire</a> options.</p>

        <h2 class="text-2xl font-bold text-[var(--color-text)] mt-12 mb-4">How Hire Works</h2>
        <ol class="space-y-3 list-decimal pl-6 text-[var(--color-text-muted)]">
          <li>Tell us the job, the site address, your dates and the attachment you need, online, by phone or on WhatsApp.</li>
          <li>We confirm the machine and attachment are free and quote delivery for your site.</li>
          <li>We deliver the excavator with the attachment.</li>
          <li>We collect it when the job is done.</li>
        </ol>

        <h2 class="text-2xl font-bold text-[var(--color-text)] mt-12 mb-4">Who This Is Not For</h2>
        <p class="text-[var(--color-text-muted)]">We only dry hire. You or your crew run the machine. If you need an operator to do the work for you, we are not the right fit.</p>
      </div>
    </section>

    <section class="bg-white py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Excavator Attachment Hire Questions</h2>
        <div class="space-y-4">
          {faqs.map(item => (
            <div class="bg-[var(--color-bg)] rounded-xl p-6">
              <h3 class="font-semibold text-[var(--color-text)]">{item.q}</h3>
              <p class="mt-3 text-[var(--color-text-muted)] text-sm leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
        <p class="text-center text-sm text-[var(--color-text-muted)] mt-8">See all our <a href="/equipment/" class="underline">equipment hire in Sydney</a> or what <a href="/blog/excavator-hire-cost-sydney/" class="underline">excavator hire costs in Sydney</a>.</p>
      </div>
    </section>

    <section class="bg-[var(--color-primary)] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Book an Excavator With an Attachment</h2>
        <p class="text-white/80 mb-8 text-lg">Tell us the job and your dates. We will confirm the machine and attachment and quote delivery.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">Book Online</a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">Call 1300 157 882</a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
