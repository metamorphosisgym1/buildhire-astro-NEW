---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Excavator Hire for Plumbers Sydney",
  "provider": { "@type": "LocalBusiness", "name": "BuildHire", "url": "https://buildhire.com.au", "telephone": "+611300157882" },
  "areaServed": { "@type": "State", "name": "New South Wales" },
  "description": "Dry hire excavators for plumbers and drainage contractors across Sydney. Mini excavators from $200/day for utility trenching, pipe laying, and reinstatement.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "AUD", "lowPrice": "200", "highPrice": "490", "offerCount": "6" },
  "dateModified": "2026-05-27",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/how-to-hire-an-excavator-in-sydney/", "name": "How to Hire an Excavator in Sydney" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/mini-excavator-licence-nsw/", "name": "Mini Excavator Licence NSW" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/excavator-hire-cost-sydney/", "name": "Excavator Hire Cost Sydney" }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What excavator is best for trenching in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "For utility trenching (water, sewer, gas, electrical) in Sydney, a 1.7T mini excavator is the most practical choice for residential work. It digs a clean, narrow trench to 2,500mm depth, fits through standard side gates, and causes minimal surface disturbance. For deeper trenches (2,500mm+) or wider excavations, the 3.5T is recommended." } },
    { "@type": "Question", "name": "How deep can a mini excavator trench in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "The 0.8T mini excavator digs to 1,800mm. The 1.7T digs to 2,500mm. The 3.5T digs to 3,400mm. For most residential plumbing and drainage work in Sydney, the 1.7T's 2,500mm depth is sufficient. For sewer connections at greater depth, the 3.5T or 5.5T is required." } },
    { "@type": "Question", "name": "Can BuildHire deliver an excavator for a one-day plumbing job in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. BuildHire offers next-day delivery for bookings placed before 12pm. Same-day delivery may be available — call 1300 157 882 to check. We understand that plumbing jobs often have urgent timelines and we work to accommodate same-day requests wherever possible." } }
  ]
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://buildhire.com.au/industries" },
    { "@type": "ListItem", "position": 3, "name": "Plumbers & Drainage", "item": "https://buildhire.com.au/industries/plumbers" }
  ]
};
---
<Layout
  title="Excavator Hire for Plumbers & Drainage Sydney | From $200/day — BuildHire"
  description="Excavator dry hire for plumbers and drainage contractors in Sydney. Utility trenching, pipe laying, and reinstatement. Mini excavators from $200/day, next-day delivery."
  canonicalPath="/industries/plumbers"
  ogImage="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">/</span>
          <a href="/industries/" class="hover:text-[var(--color-primary)]">Industries</a>
          <span class="mx-2">/</span>
          <span class="text-[var(--color-text)]">Plumbers & Drainage</span>
        </nav>
        <div class="text-center mb-10">
          <span class="inline-block bg-[var(--color-primary)] text-white text-sm font-semibold px-4 py-1 rounded-full mb-4">Plumbing & Drainage Specialists</span>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">Excavator Hire for Plumbers & Drainage Contractors in Sydney</h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">Utility trenching, sewer connections, stormwater drainage, and reinstatement — the right machine for every plumbing excavation. From <strong class="text-[var(--color-primary)]">$200/day</strong>, next-day delivery across Sydney.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Common Plumbing Excavation Jobs</h2>
        <div class="grid md:grid-cols-2 gap-8">
          {[
            { job: "Sewer Connection & Repair", machine: "1.7T or 3.5T", detail: "Excavate to the sewer main, expose the connection point, and reinstate after the plumbing work. The 1.7T handles most residential sewer depths; the 3.5T for deeper connections." },
            { job: "Water Main Connection", machine: "1.7T", detail: "Trench from the water main to the property boundary. Narrow, precise trenching with minimal surface disturbance — the 1.7T is the standard choice." },
            { job: "Stormwater Drainage", machine: "1.7T or 3.5T", detail: "Trench for stormwater pipes, install pits, and connect to the kerb. The 1.7T handles residential drainage; the 3.5T for larger commercial stormwater systems." },
            { job: "Gas Line Excavation", machine: "0.8T or 1.7T", detail: "Careful, precise trenching for gas line installation and repair. The 0.8T's compact size and precise bucket control is ideal for work near existing services." },
            { job: "Grease Trap Installation", machine: "1.7T or 3.5T", detail: "Excavate for grease trap installation in commercial kitchens and food service premises. Depth and width requirements vary — call us to confirm the right machine." },
            { job: "Reinstatement & Backfill", machine: "0.8T or 1.7T", detail: "Backfill trenches in layers, compact, and reinstate surface. The 0.8T and 1.7T provide the precision needed for clean reinstatement on residential properties." },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">{item.job}</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: {item.machine}</p>
                <p class="text-sm text-[var(--color-text-muted)]">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Plumber FAQ</h2>
        <div class="space-y-6">
          {[
            { q: "What excavator is best for trenching in Sydney?", a: "For utility trenching (water, sewer, gas, electrical) in Sydney, a 1.7T mini excavator is the most practical choice for residential work. It digs a clean, narrow trench to 2,500mm depth, fits through standard side gates, and causes minimal surface disturbance. For deeper trenches (2,500mm+) or wider excavations, the 3.5T is recommended." },
            { q: "How deep can a mini excavator trench in Sydney?", a: "The 0.8T mini excavator digs to 1,800mm. The 1.7T digs to 2,500mm. The 3.5T digs to 3,400mm. For most residential plumbing and drainage work in Sydney, the 1.7T's 2,500mm depth is sufficient. For sewer connections at greater depth, the 3.5T or 5.5T is required." },
            { q: "Can BuildHire deliver an excavator for a one-day plumbing job in Sydney?", a: "Yes. BuildHire offers next-day delivery for bookings placed before 12pm. Same-day delivery may be available — call 1300 157 882 to check. We understand that plumbing jobs often have urgent timelines and we work to accommodate same-day requests wherever possible." },
          ].map(item => (
            <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">{item.q}</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Book?</h2>
        <p class="text-white/80 mb-8 text-lg">Next-day delivery across Sydney. Same-day available — call us.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">Call 1300 157 882</a>
        </div>
      </div>
    </section>
    <Footer client:load />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
