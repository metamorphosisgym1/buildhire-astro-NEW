---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://buildhire.com.au/industries" },
    { "@type": "ListItem", "position": 3, "name": "Demolition Contractors", "item": "https://buildhire.com.au/industries/demolition-contractors" }
  ]
};
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Excavator Hire for Demolition Contractors Sydney",
  "provider": { "@type": "LocalBusiness", "@id": "https://buildhire.com.au/#organization", "name": "BuildHire", "url": "https://buildhire.com.au", "telephone": "+611300157882" },
  "areaServed": { "@type": "State", "name": "New South Wales" },
  "description": "Dry hire excavators for demolition contractors across Sydney. Structure demolition, site clearance, and debris removal. 3.5T to 23T available. From $340/day.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "AUD", "lowPrice": "325", "highPrice": "490", "offerCount": "6" },
  "dateModified": "2026-05-27",
  "url": "https://buildhire.com.au/industries/demolition-contractors",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/dry-hire-vs-wet-hire-excavator-sydney/", "name": "Dry Hire vs Wet Hire Excavator Sydney" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/what-size-excavator-do-i-need/", "name": "What Size Excavator Do I Need?" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/excavator-hire-cost-sydney/", "name": "Excavator Hire Cost Sydney" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
  {
    "@type": "Question",
    "name": "What excavator do I need for demolition work in Sydney?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "For residential demolition support in Sydney, a 3.5T or 5.5T excavator is the most common choice. The 3.5T handles material removal and site clearing on standard residential blocks. For commercial demolition or larger volumes, the 8T, 14.5T, or 23T provides the power and capacity needed."
    }
  },
  {
    "@type": "Question",
    "name": "Does BuildHire have a hydraulic breaker attachment for concrete demolition?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, a hydraulic breaker (rock hammer) attachment is available for concrete breaking and rock excavation. Call 1300 157 882 to check availability and pricing for your project."
    }
  }
]
};
---
<Layout
  title="Excavator Hire for Demolition Contractors Sydney | BuildHire"
  description="Excavator dry hire for demolition contractors in Sydney. Demolition excavation, material removal, and site clearing. 3.5T to 23T available. From $340/day."
  canonicalPath="/industries/demolition-contractors"
  ogImage="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">/</span>
          <a href="/industries/" class="hover:text-[var(--color-primary)]">Industries</a>
          <span class="mx-2">/</span>
          <span class="text-[var(--color-text)]">Demolition Contractors</span>
        </nav>
        <div class="text-center mb-10">
          <span class="inline-block bg-[var(--color-primary)] text-white text-sm font-semibold px-4 py-1 rounded-full mb-4">Demolition Specialists</span>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">Excavator Hire for Demolition Contractors in Sydney</h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">Demolition excavation, material removal, and site clearing — the right machine for every demolition project. From <strong class="text-[var(--color-primary)]">$340/day</strong>, next-day delivery across Sydney.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Common Jobs & the Right Machine</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">Residential Demolition Excavation</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: 3.5T or 5.5T</p>
                <p class="text-sm text-[var(--color-text-muted)]">Excavate and remove demolished material from residential demolition sites. The 3.5T handles standard residential blocks; the 5.5T for larger volumes.</p>
              </div>
            </div>
          <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">Commercial Demolition Support</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: 8T or 14.5T</p>
                <p class="text-sm text-[var(--color-text-muted)]">Material removal, site clearing, and excavation support for commercial demolition projects. The 8T and 14.5T provide the power and reach for larger sites.</p>
              </div>
            </div>
          <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">Slab & Footing Removal</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: 3.5T or 5.5T</p>
                <p class="text-sm text-[var(--color-text-muted)]">Break up and remove existing concrete slabs, footings, and foundations. A hydraulic breaker attachment is available — call to enquire.</p>
              </div>
            </div>
          <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">Site Clearing & Vegetation Removal</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: 3.5T</p>
                <p class="text-sm text-[var(--color-text-muted)]">Clear vegetation, remove stumps, and prepare sites for new construction following demolition. The 3.5T is the standard choice for residential site clearing.</p>
              </div>
            </div>
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">FAQ</h2>
        <div class="space-y-6">
          <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">What excavator do I need for demolition work in Sydney?</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed">For residential demolition support in Sydney, a 3.5T or 5.5T excavator is the most common choice. The 3.5T handles material removal and site clearing on standard residential blocks. For commercial demolition or larger volumes, the 8T, 14.5T, or 23T provides the power and capacity needed.</p>
            </div>
          <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">Does BuildHire have a hydraulic breaker attachment for concrete demolition?</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed">Yes, a hydraulic breaker (rock hammer) attachment is available for concrete breaking and rock excavation. Call 1300 157 882 to check availability and pricing for your project.</p>
            </div>
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Book?</h2>
        <p class="text-white/80 mb-8 text-lg">Next-day delivery across Sydney. Call us for urgent requests.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">Call 1300 157 882</a>
        </div>
      </div>
    </section>
    <Footer client:load />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
