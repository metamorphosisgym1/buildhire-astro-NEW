---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Excavator Hire for Landscapers Sydney",
  "provider": { "@type": "LocalBusiness", "name": "BuildHire", "url": "https://buildhire.com.au", "telephone": "+611300157882" },
  "areaServed": { "@type": "State", "name": "New South Wales" },
  "description": "Dry hire excavators for landscaping contractors across Sydney. Mini excavators from $200/day for retaining walls, garden beds, drainage, and earthworks.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "AUD", "lowPrice": "200", "highPrice": "490", "offerCount": "6" },
  "dateModified": "2026-05-27",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/excavator-hire-landscapers-sydney/", "name": "Excavator Hire for Landscapers Sydney" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/what-size-excavator-do-i-need/", "name": "What Size Excavator Do I Need?" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/mini-excavator-licence-nsw/", "name": "Mini Excavator Licence NSW" }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What excavator is best for landscaping in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "For most residential landscaping jobs in Sydney — retaining walls, garden bed preparation, drainage trenching — a 1.7T mini excavator is the most versatile choice. It fits through standard side gates (1,200mm+), has zero tail swing to protect fences and structures, and can dig to 2,500mm for drainage work. For larger earthworks or heavy retaining walls, the 3.5T provides more power and speed." } },
    { "@type": "Question", "name": "Can I use a mini excavator to build a retaining wall in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. A 1.7T or 3.5T excavator is ideal for retaining wall construction — excavating the footing trench, placing the base course, and backfilling behind the wall. For walls over 1,000mm high, a 3.5T is recommended for the heavier lifting and backfill compaction work." } },
    { "@type": "Question", "name": "How much does excavator hire cost for a landscaping job in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "Excavator hire for landscaping in Sydney starts from $200/day for a 0.8T and $205/day for a 1.7T. Most landscaping jobs require 1–3 days depending on the scope. Delivery & collection from $110. Weekly rates are available for ongoing projects — call 1300 157 882." } },
    { "@type": "Question", "name": "Do I need a licence to operate an excavator for landscaping in NSW?", "acceptedAnswer": { "@type": "Answer", "text": "No licence is required to operate a mini excavator under 10 tonnes on private property in NSW. On a registered worksite, a High Risk Work Licence (HRWL) may be required. Most residential landscaping jobs on private property do not require a licence." } }
  ]
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://buildhire.com.au/industries" },
    { "@type": "ListItem", "position": 3, "name": "Landscapers", "item": "https://buildhire.com.au/industries/landscapers" }
  ]
};
---
<Layout
  title="Excavator Hire for Landscapers Sydney | From $200/day — BuildHire"
  description="Excavator dry hire for landscaping contractors in Sydney. Mini excavators for retaining walls, garden beds, drainage, and earthworks. From $200/day, next-day delivery."
  canonicalPath="/industries/landscapers"
  ogImage="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">/</span>
          <a href="/industries/" class="hover:text-[var(--color-primary)]">Industries</a>
          <span class="mx-2">/</span>
          <span class="text-[var(--color-text)]">Landscapers</span>
        </nav>
        <div class="text-center mb-10">
          <span class="inline-block bg-[var(--color-primary)] text-white text-sm font-semibold px-4 py-1 rounded-full mb-4">Landscaping Specialists</span>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">Excavator Hire for Landscapers in Sydney</h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">Retaining walls, drainage, garden bed prep, and site levelling — get the right machine for your landscaping job. Dry hire from <strong class="text-[var(--color-primary)]">$200/day</strong>, next-day delivery across Sydney.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4 text-center">Common Landscaping Jobs & the Right Machine</h2>
        <div class="grid md:grid-cols-2 gap-8 mt-10">
          {[
            { job: "Retaining Wall Construction", machine: "1.7T or 3.5T", detail: "Excavate the footing trench, place the base course, and backfill behind the wall. The 1.7T suits walls up to 1,000mm; the 3.5T is better for larger retaining structures." },
            { job: "Garden Bed Preparation", machine: "0.8T or 1.7T", detail: "Strip topsoil, loosen compacted ground, and shape garden beds. The 0.8T is perfect for tight residential gardens where a full-size machine would cause damage." },
            { job: "Drainage Trenching", machine: "1.7T", detail: "Dig drainage channels, install ag-pipe, and backfill. The 1.7T's 2,500mm dig depth covers most residential drainage requirements." },
            { job: "Site Levelling & Earthworks", machine: "3.5T or 5.5T", detail: "Level sloped blocks, remove excess soil, and prepare sites for turf or paving. The 3.5T is the workhorse for most residential levelling jobs." },
            { job: "Tree Stump Removal", machine: "1.7T or 3.5T", detail: "Excavate around root systems and remove stumps without damaging surrounding lawn or structures. Zero tail swing machines are essential near fences." },
            { job: "Pond & Water Feature Excavation", machine: "0.8T or 1.7T", detail: "Precise excavation for ponds, water features, and pondless waterfalls. The 0.8T's compact size allows work in established garden areas with minimal disturbance." },
          ].map(item => (
            <div class="flex gap-4">
              <span class="text-[var(--color-primary)] font-bold text-xl mt-1">→</span>
              <div>
                <h3 class="font-bold text-[var(--color-text)] mb-1">{item.job}</h3>
                <p class="text-sm text-[var(--color-primary)] font-semibold mb-1">Recommended: {item.machine}</p>
                <p class="text-sm text-[var(--color-text-muted)]">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4">A Landscaping Job in Sydney's Northern Beaches</h2>
            <p class="text-[var(--color-text-muted)] mb-4 leading-relaxed">A landscaping contractor working in Avalon needed to build a 12-metre sandstone retaining wall on a sloped block with 1,300mm side access. The 1.7T Yanmar ViO17 was delivered at 7am. The footing trench was complete by midday, the base course was set by 3pm, and the machine was used the following day for backfilling and soil removal.</p>
            <p class="text-[var(--color-text-muted)] leading-relaxed">Total hire: 2 days at $205/day plus delivery. The job was completed on schedule with no fence damage and no site damage — the zero tail swing design of the ViO17 was the key factor on this constrained site.</p>
          </div>
          <div class="bg-white rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-[var(--color-text)] mb-6">Landscaper Hire Rates</h3>
            <div class="space-y-4">
              {[
                { machine: "0.8T Mini Excavator", rate: "$200/day", delivery: "from $110" },
                { machine: "1.7T Mini Excavator", rate: "$205/day", delivery: "from $110" },
                { machine: "3.5T Excavator", rate: "$325/day", delivery: "from $150" },
                { machine: "5.5T Excavator", rate: "$380/day", delivery: "on enquiry" },
              ].map(r => (
                <div class="flex justify-between items-center py-3 border-b border-gray-100">
                  <span class="font-medium text-[var(--color-text)]">{r.machine}</span>
                  <div class="text-right">
                    <div class="font-bold text-[var(--color-primary)]">{r.rate}</div>
                    <div class="text-xs text-[var(--color-text-muted)]">Delivery {r.delivery}</div>
                  </div>
                </div>
              ))}
            </div>
            <a href="/#booking" class="block mt-6 bg-[var(--color-primary)] text-white text-center font-bold px-6 py-3 rounded-lg hover:opacity-90 transition">Book Online Now →</a>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Landscaper FAQ</h2>
        <div class="space-y-6">
          {[
            { q: "What excavator is best for landscaping in Sydney?", a: "For most residential landscaping jobs in Sydney — retaining walls, garden bed preparation, drainage trenching — a 1.7T mini excavator is the most versatile choice. It fits through standard side gates (1,200mm+), has zero tail swing to protect fences and structures, and can dig to 2,500mm for drainage work. For larger earthworks or heavy retaining walls, the 3.5T provides more power and speed." },
            { q: "Can I use a mini excavator to build a retaining wall in Sydney?", a: "Yes. A 1.7T or 3.5T excavator is ideal for retaining wall construction — excavating the footing trench, placing the base course, and backfilling behind the wall. For walls over 1,000mm high, a 3.5T is recommended for the heavier lifting and backfill compaction work." },
            { q: "How much does excavator hire cost for a landscaping job in Sydney?", a: "Excavator hire for landscaping in Sydney starts from $200/day for a 0.8T and $205/day for a 1.7T. Most landscaping jobs require 1–3 days depending on the scope. Delivery & collection from $110. Weekly rates are available for ongoing projects — call 1300 157 882." },
          ].map(item => (
            <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">{item.q}</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-bg)] py-12">
      <div class="max-w-5xl mx-auto px-6">
        <h3 class="text-lg font-bold text-[var(--color-text)] mb-6 text-center">Other Industries We Serve</h3>
        <div class="flex flex-wrap gap-3 justify-center">
          {[["Pool Builders", "/industries/pool-builders/"], ["Builders", "/industries/builders/"], ["Plumbers", "/industries/plumbers/"], ["Civil Contractors", "/industries/civil-contractors/"], ["All Industries", "/industries/"]].map(([label, href]) => (
            <a href={href} class="px-5 py-2 rounded-full border border-gray-300 text-sm font-medium text-[var(--color-text)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition">{label}</a>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Book?</h2>
        <p class="text-white/80 mb-8 text-lg">Tell us your job and we'll match you with the right machine. Next-day delivery across Sydney.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">Call 1300 157 882</a>
        </div>
      </div>
    </section>
    <Footer client:load />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
