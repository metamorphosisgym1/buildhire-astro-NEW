---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import ChatWidget from '../../components/ChatWidget';
import StickyBottomBar from '../../components/StickyBottomBar';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Industries", "item": "https://buildhire.com.au/industries" },
    { "@type": "ListItem", "position": 3, "name": "Civil Contractors", "item": "https://buildhire.com.au/industries/civil-contractors" }
  ]
};
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Excavator Hire for Civil Contractors Sydney",
  "provider": { "@type": "LocalBusiness", "@id": "https://buildhire.com.au/#organization", "name": "BuildHire", "url": "https://buildhire.com.au", "telephone": "+611300157882" },
  "areaServed": { "@type": "State", "name": "New South Wales" },
  "description": "Dry hire excavators for civil contractors across Sydney. Bulk earthworks, road preparation, site excavation, and civil infrastructure. 3.5T to 23T available. From $325/day.",
  "offers": { "@type": "AggregateOffer", "priceCurrency": "AUD", "lowPrice": "325", "highPrice": "490", "offerCount": "6" },
  "dateModified": "2026-05-27",
  "url": "https://buildhire.com.au/industries/civil-contractors",
  "relatedLink": [
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/excavator-hire-cost-sydney/", "name": "Excavator Hire Cost Sydney" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/what-size-excavator-do-i-need/", "name": "What Size Excavator Do I Need?" },
    { "@type": "WebPage", "url": "https://buildhire.com.au/blog/dry-hire-vs-wet-hire-excavator-sydney/", "name": "Dry Hire vs Wet Hire Excavator Sydney" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What excavators does BuildHire have for civil work in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "BuildHire has a fleet from 0.8T to 23T for civil work in Sydney. For bulk earthworks and civil infrastructure, the 8T, 14.5T, and 23T Sumitomo machines are the most commonly hired. The 23T (Sumitomo SH235X-6) is our largest machine at $490/day and is suited to major civil earthworks, road preparation, and large-scale site excavation." } },
    { "@type": "Question", "name": "Does BuildHire offer weekly rates for civil contractors in Sydney?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Weekly and monthly rates are available for civil contractors with ongoing projects. Call 1300 157 882 to discuss trade pricing. We work with civil contractors across Greater Sydney and NSW on multi-week projects." } }
  ]
};
---
<Layout
  title="Excavator Hire for Civil Contractors Sydney | 8T to 23T — BuildHire"
  description="Excavator dry hire for civil contractors in Sydney. 8T, 14.5T, and 23T machines for bulk earthworks, civil infrastructure, and road preparation. Trade rates available."
  canonicalPath="/industries/civil-contractors"
  ogImage="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)] mb-6">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">/</span>
          <a href="/industries/" class="hover:text-[var(--color-primary)]">Industries</a>
          <span class="mx-2">/</span>
          <span class="text-[var(--color-text)]">Civil Contractors</span>
        </nav>
        <div class="text-center mb-10">
          <span class="inline-block bg-[var(--color-primary)] text-white text-sm font-semibold px-4 py-1 rounded-full mb-4">Civil Contractor Specialists</span>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-4">Excavator Hire for Civil Contractors in Sydney</h1>
          <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">Bulk earthworks, civil infrastructure, road preparation, and large-scale site excavation. Fleet from 3.5T to 23T. Trade rates available for ongoing projects.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
            <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
          </div>
        </div>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Civil Fleet Overview</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-[var(--color-primary)]">
                <th class="text-left py-3 font-bold text-[var(--color-text)]">Machine</th>
                <th class="text-center py-3 font-bold text-[var(--color-text)]">Daily Rate</th>
                <th class="text-center py-3 font-bold text-[var(--color-text)]">Operating Weight</th>
                <th class="text-left py-3 font-bold text-[var(--color-text)]">Best For</th>
              </tr>
            </thead>
            <tbody>
              {[
                { machine: "5.5T Excavator", rate: "$380/day", weight: "5,500 kg", best: "Medium earthworks, drainage, site prep" },
                { machine: "8T Excavator", rate: "$420/day", weight: "8,000 kg", best: "Bulk earthworks, road prep, civil infrastructure" },
                { machine: "14.5T Excavator", rate: "$450/day", weight: "14,500 kg", best: "Large civil sites, heavy earthworks" },
                { machine: "23T Sumitomo SH235X-6", rate: "$490/day", weight: "25,100 kg", best: "Major civil earthworks, large-scale excavation" },
              ].map((r, i) => (
                <tr class={`border-b border-gray-100 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
                  <td class="py-4 font-medium text-[var(--color-text)]">{r.machine}</td>
                  <td class="py-4 text-center font-bold text-[var(--color-primary)]">{r.rate}</td>
                  <td class="py-4 text-center text-[var(--color-text-muted)]">{r.weight}</td>
                  <td class="py-4 text-[var(--color-text-muted)]">{r.best}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-center text-sm text-[var(--color-text-muted)] mt-4">All prices inc. GST. Delivery for large machines via third-party transport — pricing on enquiry. <a href="tel:1300157882" class="text-[var(--color-primary)] font-semibold hover:underline">Call 1300 157 882</a> for trade and weekly rates.</p>
      </div>
    </section>
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">Civil Contractor FAQ</h2>
        <div class="space-y-6">
          {[
            { q: "What excavators does BuildHire have for civil work in Sydney?", a: "BuildHire has a fleet from 0.8T to 23T for civil work in Sydney. For bulk earthworks and civil infrastructure, the 8T, 14.5T, and 23T Sumitomo machines are the most commonly hired. The 23T (Sumitomo SH235X-6) is our largest machine at $490/day and is suited to major civil earthworks, road preparation, and large-scale site excavation." },
            { q: "Does BuildHire offer weekly rates for civil contractors in Sydney?", a: "Yes. Weekly and monthly rates are available for civil contractors with ongoing projects. Call 1300 157 882 to discuss trade pricing. We work with civil contractors across Greater Sydney and NSW on multi-week projects." },
          ].map(item => (
            <div class="border-b border-gray-200 pb-6">
              <h3 class="text-lg font-bold text-[var(--color-text)] mb-2">{item.q}</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-[var(--color-primary)] py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Get Trade Pricing</h2>
        <p class="text-white/80 mb-8 text-lg">Weekly and monthly rates available for civil contractors. Call us to discuss your project.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Get Instant Pricing →</a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">Call 1300 157 882</a>
        </div>
      </div>
    </section>
    <Footer client:load />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
