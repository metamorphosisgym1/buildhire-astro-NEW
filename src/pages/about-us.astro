---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import ChatWidget from '../components/ChatWidget';
import StickyBottomBar from '../components/StickyBottomBar';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About BuildHire",
  "description": "Learn about BuildHire, a Sydney excavator and construction equipment dry hire company. Machines from our Arncliffe yard, delivered across Sydney.",
  "url": "https://buildhire.com.au/about-us/",
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://buildhire.com.au/#organization",
    "name": "BuildHire",
    "url": "https://buildhire.com.au",
    "founder": {
      "@type": "Person",
      "@id": "https://buildhire.com.au/about-us/#founder",
      "name": "BuildHire Team",
      "jobTitle": "Founder",
      "url": "https://buildhire.com.au/about-us/",
      "worksFor": { "@type": "Organization", "@id": "https://buildhire.com.au/#organization" },
      "knowsAbout": ["Excavator Hire", "Mini Excavator Operation", "Construction Equipment Hire", "Dry Hire", "Plant Hire NSW", "Earthmoving Sydney", "Excavator Delivery"]
    }
  }
};
---
<Layout
  crumbs={[{ name: "About", path: "/about-us/" }]}
  title="About BuildHire | Sydney Excavator Hire"
  description="Learn about BuildHire, a Sydney excavator and construction equipment dry hire company. Machines from our Arncliffe yard, delivered across Sydney."
  canonicalPath="/about-us"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <main>
      <section class="bg-[var(--color-bg)] pt-32 pb-12">
        <div class="max-w-3xl mx-auto px-6">
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">About BuildHire</h1>
          <p class="text-xl text-[var(--color-text-muted)]">
            BuildHire is a Sydney excavator and equipment dry hire business. Our machines sit at our yard in Arncliffe, and we deliver them to sites across Sydney.
          </p>
        </div>
      </section>
      <section class="bg-white py-12">
        <div class="max-w-3xl mx-auto px-6 space-y-6 text-[var(--color-text-muted)] text-lg">
          <p>We dry hire excavators from 0.8 to 23 tonnes, plus a tipper truck. Homeowners use our mini excavators for backyards, pools and landscaping. Builders, plumbers and civil contractors use the bigger machines for site cuts, trenching, bulk earthworks and demolition.</p>
          <p>Daily rates are shown on each <a href="/equipment/" class="underline">machine page</a>. Delivery and collection are quoted for your site and hire dates. We also do weekly, monthly and contract hire for longer projects.</p>
          <p>Will runs BuildHire and stays in touch with every customer through the hire. Pickups from the yard are by arrangement.</p>
        </div>
      </section>
      <section class="bg-[var(--color-bg)] py-12">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">Business details</h2>
          <ul class="space-y-2 text-[var(--color-text-muted)] text-lg">
            <li>Build Hire Pty Ltd, trading as BuildHire</li>
            <li>ABN 88 690 624 429, active since September 2025</li>
            <li>Machine yard: 178 Princes Hwy, Arncliffe NSW 2205</li>
            <li>Phone: <a href="tel:1300157882" class="underline">1300 157 882</a></li>
            <li>Email: <a href="mailto:info@buildhire.com.au" class="underline">info@buildhire.com.au</a></li>
          </ul>
        </div>
      </section>
    </main>
    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
