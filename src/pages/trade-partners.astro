---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import ChatWidget from '../components/ChatWidget';
import StickyBottomBar from '../components/StickyBottomBar';

const canonicalPath = '/trade-partners/';
const whatsappUrl = 'https://wa.me/61435421324?text=Hi%20BuildHire%2C%20I%27d%20like%20to%20discuss%20a%20trade%20partner%20hire%20arrangement.';
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Trade Partner Equipment Hire Support',
  provider: {
    '@type': 'LocalBusiness',
    name: 'BuildHire',
    url: 'https://buildhire.com.au/',
    telephone: '+611300157882',
  },
  areaServed: { '@type': 'State', name: 'New South Wales' },
  description: 'Equipment-hire support for Sydney and NSW trade businesses, including builders, landscapers, pool builders, plumbers, drainage contractors and civil contractors.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who can discuss a BuildHire trade partner arrangement?',
      acceptedAnswer: { '@type': 'Answer', text: 'BuildHire welcomes enquiries from trade businesses that regularly need dry-hire equipment, including builders, landscapers, pool builders, plumbers, drainage contractors, demolition crews and civil contractors.' },
    },
    {
      '@type': 'Question',
      name: 'What details should a trade partner share when requesting equipment?',
      acceptedAnswer: { '@type': 'Answer', text: 'Share the equipment type, dates, delivery suburb, job type, site-access constraints and any attachment requirements. BuildHire can then confirm availability and delivery pricing for the specific job.' },
    },
  ],
};
---

<Layout
  title="Trade Partner Equipment Hire | Sydney & NSW — BuildHire"
  description="Discuss a repeat-hire workflow with BuildHire for your construction, landscaping, pool, drainage, demolition or civil projects across Sydney and NSW."
  canonicalPath={canonicalPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen pb-20">
    <Header client:load />
    <main>
      <section class="bg-[var(--color-bg)] pt-28 pb-16">
        <div class="max-w-5xl mx-auto px-6 text-center">
          <p class="inline-flex rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] px-4 py-2 text-sm font-semibold mb-6">For repeat-hire trade businesses</p>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">Build a clearer equipment-hire workflow for every job</h1>
          <p class="text-xl text-[var(--color-text-muted)] leading-relaxed max-w-3xl mx-auto">If your business regularly needs excavators, attachments, dumpers or tipper trucks, speak with BuildHire about a practical repeat-hire workflow. Every job is confirmed against availability, site access, dates and delivery requirements.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center mt-10">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg">Discuss a Trade Partner Arrangement →</a>
            <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg">Call 1300 157 882</a>
          </div>
        </div>
      </section>

      <section class="bg-white py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-3xl font-bold text-[var(--color-text)] text-center mb-10">Built for the trades that keep Sydney moving</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              ['Builders & concreters', 'Footings, site preparation, drainage and residential earthworks.'],
              ['Landscapers', 'Tight-access excavation, retaining work, soil movement and site preparation.'],
              ['Pool builders', 'Excavation planning, access checks, spoil-management coordination and attachments.'],
              ['Plumbers & drainage contractors', 'Trenching, access-sensitive digs and utility preparation.'],
              ['Demolition contractors', 'Appropriate machine and attachment discussions for removal work.'],
              ['Civil contractors', 'Larger equipment enquiries for project-specific scope, access and transport planning.'],
            ].map(([title, description]) => (
              <article class="rounded-xl border border-gray-100 bg-[var(--color-bg)] p-6">
                <h3 class="font-bold text-[var(--color-text)] mb-2">{title}</h3>
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-[var(--color-bg)] py-16">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-3xl font-bold text-[var(--color-text)] text-center mb-10">What to include in a repeat-hire enquiry</h2>
          <ol class="space-y-4">
            {[
              'Machine or attachment required, or a clear description of the job.',
              'Preferred hire start and finish dates.',
              'Delivery suburb and any access or unloading constraints.',
              'Whether the job is residential, commercial or civil, plus any timing constraints.',
              'Your business name and preferred contact method for future job planning.',
            ].map((item, index) => (
              <li class="flex gap-4 bg-white rounded-xl p-5 border border-gray-100">
                <span class="shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-[var(--color-primary)] text-white font-bold">{index + 1}</span>
                <span class="text-[var(--color-text-muted)] leading-relaxed">{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="bg-white py-16">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-3xl font-bold text-[var(--color-text)] text-center mb-8">Trade Partner FAQs</h2>
          <div class="space-y-4">
            {[
              ['Who can discuss a BuildHire trade partner arrangement?', 'BuildHire welcomes enquiries from trade businesses that regularly need dry-hire equipment, including builders, landscapers, pool builders, plumbers, drainage contractors, demolition crews and civil contractors.'],
              ['What details should a trade partner share when requesting equipment?', 'Share the equipment type, dates, delivery suburb, job type, site-access constraints and any attachment requirements. BuildHire can then confirm availability and delivery pricing for the specific job.'],
            ].map(([question, answer]) => (
              <details class="bg-[var(--color-bg)] rounded-xl p-6 group">
                <summary class="font-semibold text-[var(--color-text)] cursor-pointer list-none flex justify-between gap-4">{question}<span class="text-[var(--color-primary)] group-open:rotate-45 transition-transform">+</span></summary>
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)] mt-4">{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
