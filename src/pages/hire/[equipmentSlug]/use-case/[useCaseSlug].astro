---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header';
import Footer from '../../../../components/Footer';
import ChatWidget from '../../../../components/ChatWidget';
import StickyBottomBar from '../../../../components/StickyBottomBar';
import { equipment } from '../../../../data/equipment';
import { useCases } from '../../../../data/use-cases';
import { locations } from '../../../../data/locations';

export async function getStaticPaths() {
  return equipment.flatMap(item =>
    useCases
      .filter(uc => uc.equipmentRecommendations.includes(item.slug))
      .map(useCase => ({
        params: { equipmentSlug: item.slug, useCaseSlug: useCase.slug },
        props: { item, useCase }
      }))
  );
}

const { item, useCase } = Astro.props;
const title = `${item.shortName} Hire for ${useCase.name} | From ${item.price} — BuildHire`;
const description = `Hire a ${item.shortName.toLowerCase()} for ${useCase.name.toLowerCase()} anywhere in NSW. BuildHire offers late-model ${item.shortName.toLowerCase()} from ${item.price} with next-day delivery across Sydney and NSW.`;
const canonicalPath = `/hire/${item.slug}/use-case/${useCase.slug}/`;

// Top 6 locations for internal linking
const topLocations = locations.slice(0, 6);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Equipment Hire", "item": "https://www.buildhire.com.au/equipment" },
    { "@type": "ListItem", "position": 3, "name": `${item.shortName} Hire`, "item": `https://www.buildhire.com.au/hire/${item.slug}/sydney/` },
    { "@type": "ListItem", "position": 4, "name": useCase.name, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${item.shortName} Hire for ${useCase.name}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "BuildHire",
    "url": "https://buildhire.com.au",
    "telephone": "+611300157882"
  },
  "areaServed": { "@type": "State", "name": "New South Wales" },
  "description": description,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "AUD",
    "price": item.priceNum,
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": item.priceNum,
      "priceCurrency": "AUD",
      "unitText": "DAY"
    }
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": useCase.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---
<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-[var(--color-bg)]">
    <Header client:load />

    <!-- Breadcrumb -->
    <div class="bg-white border-b border-gray-100 py-3">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[var(--color-text-muted)]">
          <a href="/" class="hover:text-[var(--color-primary)]">Home</a>
          <span class="mx-2">›</span>
          <a href="/equipment" class="hover:text-[var(--color-primary)]">Equipment Hire</a>
          <span class="mx-2">›</span>
          <a href={`/hire/${item.slug}/sydney/`} class="hover:text-[var(--color-primary)]">{item.shortName} Hire</a>
          <span class="mx-2">›</span>
          <span class="text-[var(--color-text)]">{useCase.name}</span>
        </nav>
      </div>
    </div>

    <!-- Hero -->
    <section class="bg-[var(--color-text)] py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="inline-block bg-[var(--color-primary)] text-white text-xs font-bold px-3 py-1 rounded-full mb-6 uppercase tracking-wider">
          {useCase.name}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          {item.shortName} Hire for {useCase.name}
        </h1>
        <p class="text-white/70 text-xl mb-8 max-w-2xl">
          {useCase.description} BuildHire supplies late-model {item.shortName.toLowerCase()} from {item.price} with next-day delivery across Sydney and NSW.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg text-center">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-text)] transition text-lg text-center">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <!-- Pricing Card -->
    <section class="bg-white py-12">
      <div class="max-w-5xl mx-auto px-6">
        <div class="bg-[var(--color-bg)] rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <div class="text-sm text-[var(--color-text-muted)] mb-1">Hire Rate (incl GST)</div>
            <div class="text-4xl font-bold text-[var(--color-primary)]">{item.price}</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-1">+ $110 delivery & collection</div>
          </div>
          <div class="grid grid-cols-2 gap-4 flex-1 max-w-md">
            {item.specs.slice(0, 4).map(spec => (
              <div class="bg-white rounded-xl p-4 text-center">
                <div class="text-xs text-[var(--color-text-muted)] mb-1">{spec.label}</div>
                <div class="font-bold text-[var(--color-text)]">{spec.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why this machine for this use case -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4">
          Why Use a {item.shortName} for {useCase.name}?
        </h2>
        <p class="text-[var(--color-text-muted)] text-lg mb-10">
          The {item.shortName} is one of the most effective machines for {useCase.name.toLowerCase()} projects across NSW. {useCase.description}
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          {[
            { icon: "⚡", title: "Purpose-Built Performance", desc: `The ${item.shortName} delivers the power and precision needed for ${useCase.name.toLowerCase()} work.` },
            { icon: "🚛", title: "Next-Day Delivery", desc: "Book before 12pm for next-day delivery to your site anywhere in Greater Sydney and NSW." },
            { icon: "💰", title: `From ${item.price}`, desc: "Transparent, all-inclusive pricing with no hidden fees or surprise surcharges." },
            { icon: "🔧", title: "Late-Model Fleet", desc: "All machines are regularly serviced and maintained to the highest standards." }
          ].map(card => (
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="text-3xl mb-3">{card.icon}</div>
              <h3 class="font-bold text-[var(--color-text)] mb-2">{card.title}</h3>
              <p class="text-sm text-[var(--color-text-muted)]">{card.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Location Links -->
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-[var(--color-text)] mb-8">
          {item.shortName} Hire for {useCase.name} — By Location
        </h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          {topLocations.map(loc => (
            <a href={`/hire/${item.slug}/${loc.slug}/${useCase.slug}/`} class="bg-[var(--color-bg)] rounded-xl px-5 py-4 hover:shadow-md transition group flex justify-between items-center">
              <span class="font-medium text-[var(--color-text)] group-hover:text-[var(--color-primary)] transition">{item.shortName} Hire for {useCase.name} in {loc.name}</span>
              <span class="text-[var(--color-primary)] ml-2">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {useCase.faqs.map(faq => (
            <details class="bg-white rounded-xl p-6 shadow-sm group">
              <summary class="font-semibold text-[var(--color-text)] cursor-pointer list-none flex justify-between items-center">
                {faq.q}
                <span class="text-[var(--color-primary)] ml-4 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-4 text-[var(--color-text-muted)] text-sm leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Hire a {item.shortName} for {useCase.name}?
        </h2>
        <p class="text-white/80 mb-8 text-lg">
          Book online in 60 seconds or call us for an instant quote. Next-day delivery available across Sydney & NSW.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
