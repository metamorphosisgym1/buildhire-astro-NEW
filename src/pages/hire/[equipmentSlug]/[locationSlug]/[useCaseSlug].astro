---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header';
import Footer from '../../../../components/Footer';
import ChatWidget from '../../../../components/ChatWidget';
import StickyBottomBar from '../../../../components/StickyBottomBar';
import { equipment } from '../../../../data/equipment';
import { locations } from '../../../../data/locations';
import { useCases } from '../../../../data/use-cases';

export async function getStaticPaths() {
  return equipment.flatMap(item =>
    // Priority filter: only build 15 priority locations to stay within Netlify build limits
    locations.filter(l => ['sydney','parramatta','penrith','liverpool','campbelltown','blacktown','castle-hill','hornsby','sutherland','chatswood','newcastle','wollongong','inner-west','northern-beaches','eastern-suburbs'].includes(l.slug)).flatMap(location =>
      useCases
        .filter(uc => uc.equipmentRecommendations.includes(item.slug))
        .map(useCase => ({
          params: { 
            equipmentSlug: item.slug, 
            locationSlug: location.slug,
            useCaseSlug: useCase.slug
          },
          props: { item, location, useCase }
        }))
    )
  );
}

const { item, location, useCase } = Astro.props;

const title = `${useCase.name} with ${item.shortName} in ${location.name} | BuildHire`;
const description = `Hire a ${item.shortName.toLowerCase()} for ${useCase.name.toLowerCase()} in ${location.name}. BuildHire offers late-model equipment perfect for ${useCase.description.toLowerCase()} with delivery across ${location.region}.`;
const canonicalPath = `/hire/${item.slug}/${location.slug}/${useCase.slug}/`;
const parentPath = `/hire/${item.slug}/${location.slug}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Equipment Hire", "item": "https://www.buildhire.com.au/equipment" },
    { "@type": "ListItem", "position": 3, "name": `${item.shortName} Hire ${location.name}`, "item": `https://www.buildhire.com.au${parentPath}` },
    { "@type": "ListItem", "position": 4, "name": useCase.name, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};


const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Equipment Hire',
  'provider': { '@type': 'LocalBusiness', 'name': 'BuildHire' },
  'areaServed': { '@type': 'State', 'name': location.name },
  'hasOfferCatalog': {
    '@type': 'OfferCatalog',
    'name': 'Equipment Hire Services',
    'itemListElement': [{ '@type': 'Offer', 'itemOffered': { '@type': 'Product', 'name': item.name + ' Hire', 'description': item.description, 'offers': { '@type': 'Offer', 'priceCurrency': 'AUD', 'price': item.price.replace(/[^0-9.]/g, ''), 'priceSpecification': { '@type': 'UnitPriceSpecification', 'price': item.price.replace(/[^0-9.]/g, ''), 'priceCurrency': 'AUD', 'unitText': 'DAY' }, 'availability': 'https://schema.org/InStock', 'seller': { '@type': 'LocalBusiness', 'name': 'BuildHire', 'url': 'https://www.buildhire.com.au' } } } }]
  }
};
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'How to hire a ' + item.name + ' for ' + useCase.name + ' in ' + location.name,
  'step': [
    { '@type': 'HowToStep', 'name': 'Check Availability', 'text': 'Contact BuildHire to check availability of ' + item.name + ' in ' + location.name + '.' },
    { '@type': 'HowToStep', 'name': 'Book Equipment', 'text': 'Confirm your booking dates and arrange delivery or pickup.' },
    { '@type': 'HowToStep', 'name': 'Complete Project', 'text': 'Use the equipment to successfully complete your ' + useCase.name + ' project.' }
  ]
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": useCase.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath}
  noindex={true}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="min-h-screen pb-20">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <!-- Breadcrumb -->
        <nav class="text-sm text-[var(--color-text-muted)] mb-6 flex items-center gap-2 flex-wrap">
          <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
          <span>/</span>
          <a href="/equipment" class="hover:text-[var(--color-primary)] transition-colors">Equipment Hire</a>
          <span>/</span>
          <a href={parentPath} class="hover:text-[var(--color-primary)] transition-colors">{item.shortName} in {location.name}</a>
          <span>/</span>
          <span class="text-[var(--color-text)]">{useCase.name}</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6">
          📍 {location.name}, {location.region}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
          {item.shortName} Hire for {useCase.name} in {location.name}
        </h1>

        <p class="text-xl text-[var(--color-text-muted)] mb-10 max-w-3xl leading-relaxed">
          Need to tackle {useCase.name.toLowerCase()} in {location.name}? The {item.name} is the perfect machine for the job. {useCase.description}
        </p>

        <!-- Pricing Cards -->
        <div class="grid sm:grid-cols-2 gap-6 mb-10 max-w-xl">
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="text-sm text-[var(--color-text-muted)] mb-1">Dry Hire Rate</div>
            <div class="text-3xl font-bold text-[var(--color-text)]">{item.price}</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-1">incl. GST</div>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="text-sm text-[var(--color-text-muted)] mb-1">Transport to {location.name}</div>
            <div class="text-lg font-semibold text-[var(--color-text)]">{item.delivery}</div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)]/90 transition text-lg text-center">
            Book Online Now →
          </a>
          <a href={parentPath} class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg text-center">
            View Machine Specs
          </a>
        </div>
      </div>
    </section>

    <!-- Why This Machine -->
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-6">
          Why use a {item.shortName} for {useCase.name}?
        </h2>
        <div class="prose max-w-none text-[var(--color-text-muted)] text-lg">
          <p>
            When it comes to {useCase.name.toLowerCase()} in {location.name}, having the right equipment makes all the difference. The {item.name} offers the perfect balance of power and precision.
          </p>
          <p class="mt-4">
            {item.longDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">
          {useCase.name} FAQs
        </h2>
        <div class="space-y-4">
          {useCase.faqs.map(faq => (
            <details class="bg-white rounded-xl p-6 shadow-sm group">
              <summary class="font-semibold text-[var(--color-text)] cursor-pointer list-none flex justify-between items-center">
                {faq.q}
                <span class="text-[var(--color-primary)] ml-4 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-4 text-[var(--color-text-muted)] text-sm leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Book Your {item.shortName} in {location.name}?
        </h2>
        <p class="text-white/80 mb-8 text-lg">
          Book online in 60 seconds or call us for an instant quote. Next-day delivery available across {location.region} & NSW.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
