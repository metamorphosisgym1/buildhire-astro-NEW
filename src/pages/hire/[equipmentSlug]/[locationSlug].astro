---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header';
import Footer from '../../../components/Footer';
import ChatWidget from '../../../components/ChatWidget';
import StickyBottomBar from '../../../components/StickyBottomBar';
import { equipment } from '../../../data/equipment';
import { locations } from '../../../data/locations';

export async function getStaticPaths() {
  return equipment.flatMap(item =>
    locations.map(location => ({
      params: { equipmentSlug: item.slug, locationSlug: location.slug },
      props: { item, location }
    }))
  );
}

const { item, location } = Astro.props;

const title = `${item.name} Hire in ${location.name} | From ${item.price} — BuildHire`;
const description = `Looking for ${item.shortName.toLowerCase()} hire in ${location.name}? BuildHire offers late-model ${item.shortName.toLowerCase()} from ${item.price} with next-day delivery across ${location.region}, ${location.state}.`;
const canonicalPath = `/hire/${item.slug}/${location.slug}/`;
const relatedEquipment = equipment
  .filter((candidate) => candidate.category === item.category && candidate.slug !== item.slug)
  .slice(0, 3);
const nearbyLocations = locations
  .filter((candidate) => candidate.region === location.region && candidate.slug !== location.slug)
  .slice(0, 5);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${item.shortName} Hire ${location.name}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "BuildHire",
    "url": "https://buildhire.com.au",
    "telephone": "+611300157882",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Sydney",
      "addressRegion": "NSW",
      "addressCountry": "AU"
    }
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": location.name
  },
  "description": description,
  "offers": {
    "@type": "Offer",
    "priceCurrency": "AUD",
    "price": item.priceNum,
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": item.priceNum,
      "priceCurrency": "AUD",
      "unitText": "DAY"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.buildhire.com.au" },
    { "@type": "ListItem", "position": 2, "name": "Equipment Hire", "item": "https://www.buildhire.com.au/equipment" },
    { "@type": "ListItem", "position": 3, "name": `${item.shortName} Hire ${location.name}`, "item": `https://www.buildhire.com.au${canonicalPath}` }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    ...item.faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    })),
    {
      "@type": "Question",
      "name": `Do you deliver ${item.shortName.toLowerCase()}s to ${location.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, we offer next-day delivery for our ${item.shortName.toLowerCase()}s to ${location.name} and the wider ${location.region} region for bookings placed before 12pm. Call 1300 157 882 to confirm availability.`
      }
    }
  ]
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="min-h-screen pb-20">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[var(--color-bg)] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <!-- Breadcrumb -->
        <nav class="text-sm text-[var(--color-text-muted)] mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-[var(--color-primary)] transition-colors">Home</a>
          <span>/</span>
          <a href="/equipment/" class="hover:text-[var(--color-primary)] transition-colors">Equipment Hire</a>
          <span>/</span>
          <span class="text-[var(--color-text)]">{item.shortName} in {location.name}</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6">
          📍 Available in {location.name}, {location.region}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] mb-6">
          {item.name} Hire in {location.name}
        </h1>

        <p class="text-xl text-[var(--color-text-muted)] mb-10 max-w-3xl leading-relaxed">
          {item.longDescription} We supply premium, late-model {item.category.toLowerCase()} to contractors and builders across {location.name}.
        </p>

        <!-- Pricing Cards -->
        <div class="grid sm:grid-cols-2 gap-6 mb-10 max-w-xl">
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="text-sm text-[var(--color-text-muted)] mb-1">Dry Hire Rate</div>
            <div class="text-3xl font-bold text-[var(--color-text)]">{item.price}</div>
            <div class="text-sm text-[var(--color-text-muted)] mt-1">incl. GST</div>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
            <div class="text-sm text-[var(--color-text-muted)] mb-1">Transport to {location.name}</div>
            <div class="text-lg font-semibold text-[var(--color-text)]">{item.delivery}</div>
            {item.delivery === "Price on request" && (
              <div class="text-xs text-[var(--color-text-muted)] mt-2">Confirmed once we have your site and hire details.</div>
            )}
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/#booking" class="bg-[var(--color-primary)] text-white font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)]/90 transition text-lg text-center">
            Check Availability & Get a Quote →
          </a>
          <a href="tel:1300157882" class="border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-[var(--color-primary)] hover:text-white transition text-lg text-center">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <!-- Specs -->
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10">Machine Specifications</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
          {item.specs.map(spec => (
            <div class="bg-[var(--color-bg)] rounded-xl p-6 text-center">
              <div class="text-sm text-[var(--color-text-muted)] mb-2">{spec.label}</div>
              <div class="text-xl font-bold text-[var(--color-text)]">{spec.value}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4">
          What Can You Use a {item.shortName} For in {location.name}?
        </h2>
        <p class="text-[var(--color-text-muted)] mb-10 text-lg">
          The {item.shortName} is one of the most versatile machines on any {location.region} worksite.
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          {item.useCases.map(uc => (
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <h3 class="font-bold text-[var(--color-text)] mb-2">{uc.title}</h3>
              <p class="text-sm text-[var(--color-text-muted)]">{uc.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why BuildHire -->
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">
          Why Hire From BuildHire in {location.name}?
        </h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
          {[
            { icon: "🚛", title: "Next-Day Delivery", desc: `Book before 12pm for next-day delivery to ${location.name}.` },
            { icon: "💰", title: "Transparent Pricing", desc: "No hidden fees. The price you see is the price you pay." },
            { icon: "🔧", title: "Well-Maintained Fleet", desc: "Low-hour Yanmar machines serviced to the highest standards." },
            { icon: "📞", title: "24/7 Support", desc: "Round-the-clock support if anything comes up on site." }
          ].map(item => (
            <div class="text-center p-6 bg-[var(--color-bg)] rounded-xl">
              <div class="text-4xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-[var(--color-text)] mb-2">{item.title}</h3>
              <p class="text-sm text-[var(--color-text-muted)]">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Job planning and internal navigation -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-5xl mx-auto px-6 grid lg:grid-cols-2 gap-10">
        <div>
          <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4">Before You Request a {item.shortName} Quote</h2>
          <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">
            To confirm availability and transport for your {location.name} site, have your preferred dates, delivery suburb, job type and any access constraints ready. This helps the team confirm the right machine and delivery arrangement without guessing.
          </p>
          <a href="/#booking" class="inline-flex items-center justify-center bg-[var(--color-primary)] text-white font-bold px-6 py-3 rounded-lg hover:bg-[var(--color-primary)]/90 transition">
            Start a Quote Request →
          </a>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6">
          <h3 class="text-xl font-bold text-[var(--color-text)] mb-4">Related Equipment for {location.name}</h3>
          <ul class="space-y-3">
            {relatedEquipment.map((candidate) => (
              <li>
                <a href={`/hire/${candidate.slug}/${location.slug}/`} class="group flex items-center justify-between gap-4 text-[var(--color-text)] hover:text-[var(--color-primary)] transition">
                  <span>{candidate.shortName} Hire in {location.name}</span>
                  <span class="text-[var(--color-primary)] group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {nearbyLocations.length > 0 && (
      <section class="bg-white py-16">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-3xl font-bold text-[var(--color-text)] mb-4">{item.shortName} Hire Across {location.region}</h2>
          <p class="text-[var(--color-text-muted)] mb-8">Explore nearby service-area pages for the same equipment. Delivery and collection are quoted for each site and hire period.</p>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
            {nearbyLocations.map((nearby) => (
              <a href={`/hire/${item.slug}/${nearby.slug}/`} class="rounded-xl border border-gray-100 bg-[var(--color-bg)] px-5 py-4 font-medium text-[var(--color-text)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition">
                {item.shortName} Hire in {nearby.name}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="bg-[var(--color-bg)] py-16">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[var(--color-text)] mb-10 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {[
            ...item.faqs,
            {
              q: `Do you deliver ${item.shortName.toLowerCase()}s to ${location.name}?`,
              a: `Yes, we offer next-day delivery to ${location.name} and the wider ${location.region} region for bookings placed before 12pm. Call 1300 157 882 to confirm availability for your specific area.`
            }
          ].map(faq => (
            <details class="bg-white rounded-xl p-6 shadow-sm group">
              <summary class="font-semibold text-[var(--color-text)] cursor-pointer list-none flex justify-between items-center">
                {faq.q}
                <span class="text-[var(--color-primary)] ml-4 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-4 text-[var(--color-text-muted)] text-sm leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-primary)] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          Ready to Book Your {item.shortName} in {location.name}?
        </h2>
        <p class="text-white/80 mb-8 text-lg">
          Send your dates and site details for availability, hire pricing and a delivery quote. Next-day delivery may be available across {location.region} and NSW.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[var(--color-primary)] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">
            Start a Quote Request →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[var(--color-primary)] transition text-lg">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
