---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import ChatWidget from '../components/ChatWidget';
import StickyBottomBar from '../components/StickyBottomBar';
import { serviceAreaContent } from '../data/serviceAreaContent';

const title = "Excavator Hire Service Areas | Sydney & NSW — BuildHire";
const description = "BuildHire delivers excavators and construction equipment across Sydney and all of NSW. Find your service area and get an instant quote. Next-day delivery guaranteed.";

// Group locations by region
const regions: Record<string, typeof serviceAreaContent> = {};
for (const area of serviceAreaContent) {
  if (!regions[area.region]) regions[area.region] = [];
  regions[area.region].push(area);
}

const regionOrder = [
  "Sydney Metro",
  "Western Sydney",
  "South-West Sydney",
  "Hills District",
  "Northern Sydney",
  "South Sydney",
  "Inner Sydney",
  "NSW Regional"
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://buildhire.com.au/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://buildhire.com.au/service-areas/" }
  ]
};
---

<Layout title={title} description={description} canonicalPath="/service-areas/">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="min-h-screen pb-20">
    <Header client:load />

    <!-- Hero -->
    <section class="bg-[hsl(var(--background))] pt-28 pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <nav class="text-sm text-[hsl(var(--muted-foreground))] mb-6 flex items-center gap-2">
          <a href="/" class="hover:text-[hsl(var(--primary))] transition-colors">Home</a>
          <span>/</span>
          <span class="text-[hsl(var(--foreground))]">Service Areas</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[hsl(var(--primary))]/10 text-[hsl(var(--primary))] text-sm font-semibold mb-6">
          📍 Serving Sydney Metro & All of NSW
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-[hsl(var(--foreground))] mb-6 leading-tight tracking-tight">
          Excavator Hire Service Areas
        </h1>
        <p class="text-xl text-[hsl(var(--muted-foreground))] mb-8 max-w-3xl leading-relaxed">
          BuildHire delivers late-model Yanmar and Sumitomo excavators across Sydney and all of NSW. Find your area below for local pricing, availability, and next-day delivery.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/#booking" class="bg-[hsl(var(--primary))] text-white font-bold px-8 py-4 rounded-lg hover:opacity-90 transition text-lg text-center">
            Get an Instant Quote →
          </a>
          <a href="tel:1300157882" class="border-2 border-[hsl(var(--primary))] text-[hsl(var(--primary))] font-bold px-8 py-4 rounded-lg hover:bg-[hsl(var(--primary))] hover:text-white transition text-lg text-center">
            📞 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <!-- Locations by Region -->
    <section class="bg-white py-16">
      <div class="max-w-5xl mx-auto px-6">
        {regionOrder.map(regionName => {
          const areas = regions[regionName];
          if (!areas || areas.length === 0) return null;
          return (
            <div class="mb-14">
              <h2 class="text-2xl font-bold text-[hsl(var(--foreground))] mb-6 tracking-tight border-b border-[hsl(var(--border))] pb-3">
                {regionName}
              </h2>
              <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
                {areas.map(area => (
                  <a
                    href={`/service-areas/${area.slug}/`}
                    class="group bg-[hsl(var(--background))] border border-[hsl(var(--border))] rounded-xl p-5 hover:border-[hsl(var(--primary))] hover:shadow-md transition-all"
                  >
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <h3 class="font-bold text-[hsl(var(--foreground))] group-hover:text-[hsl(var(--primary))] transition-colors mb-1">
                          Excavator Hire {area.name}
                        </h3>
                        <p class="text-xs text-[hsl(var(--muted-foreground))]">
                          {area.suburbs.slice(0, 3).join(", ")}{area.suburbs.length > 3 ? ` + ${area.suburbs.length - 3} more` : ""}
                        </p>
                      </div>
                      <span class="text-[hsl(var(--primary))] text-lg shrink-0 group-hover:translate-x-1 transition-transform">→</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Trust Section -->
    <section class="bg-[hsl(var(--background))] py-16">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-[hsl(var(--foreground))] mb-10 tracking-tight text-center">
          Why Contractors Across NSW Choose BuildHire
        </h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6">
          {[
            { icon: "🚛", title: "Next-Day Delivery", desc: "Book before 12pm for guaranteed next-day delivery to your site." },
            { icon: "💰", title: "All-In Pricing", desc: "Delivery, collection, and fuel included. No hidden fees, ever." },
            { icon: "🔧", title: "Late-Model Fleet", desc: "Low-hour Yanmar and Sumitomo machines maintained in-house." },
            { icon: "📱", title: "WhatsApp Booking", desc: "Message our team for same-day enquiries and instant pricing." }
          ].map(item => (
            <div class="bg-white rounded-xl p-6 text-center shadow-sm border border-[hsl(var(--border))]">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-[hsl(var(--foreground))] mb-2 text-sm">{item.title}</h3>
              <p class="text-xs text-[hsl(var(--muted-foreground))] leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[hsl(var(--primary))] py-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4 tracking-tight">
          Can't Find Your Area?
        </h2>
        <p class="text-white/80 mb-8 text-lg">
          We deliver across all of NSW. Call us or send a WhatsApp message and we'll confirm availability for your location within minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#booking" class="bg-white text-[hsl(var(--primary))] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition text-lg">
            Book Online Now →
          </a>
          <a href="tel:1300157882" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white hover:text-[hsl(var(--primary))] transition text-lg">
            Call 1300 157 882
          </a>
        </div>
      </div>
    </section>

    <Footer client:visible />
    <ChatWidget client:load />
    <StickyBottomBar client:load />
  </div>
</Layout>
